<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPlasma.Spotlight.Views.SpotlightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinPlasma.Spotlight.Services">

    <!--
        Centered, 680px wide, transparent background with acrylic blur.
        Dismissed by pressing Escape or clicking outside.
        Opens in < 200ms — window is pre-created and hidden, not re-created on each toggle.
    -->

    <Grid>
        <!-- Click-to-dismiss overlay (covers full screen) -->
        <Rectangle x:Name="DismissOverlay" Fill="Transparent"
                   PointerPressed="DismissOverlay_PointerPressed" />

        <!-- Search card (centered) -->
        <Border x:Name="SearchCard"
                Width="680" MaxHeight="600"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="12"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                Margin="0,-100,0,0">

            <Border.Background>
                <AcrylicBrush TintColor="#1A1A2E" TintOpacity="0.85" />
            </Border.Background>

            <Grid RowDefinitions="Auto,*">

                <!-- Search input -->
                <Border Grid.Row="0" Padding="20,16,20,12"
                        BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Search icon -->
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18"
                                  Foreground="#88FFFFFF" Margin="0,0,12,0"
                                  VerticalAlignment="Center" />

                        <!-- Search TextBox -->
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 PlaceholderText="Search apps, files, settings…"
                                 FontSize="16"
                                 FontFamily="Segoe UI Variable"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 VerticalAlignment="Center" />

                        <!-- Clear button -->
                        <Button Grid.Column="2" x:Name="ClearButton"
                                Visibility="Collapsed"
                                Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                                Click="ClearButton_Click"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#88FFFFFF" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Results list -->
                <ScrollViewer Grid.Row="1" Padding="8,8,8,8">
                    <StackPanel x:Name="ResultsPanel" Spacing="2">

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                    Padding="0,40" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="#33FFFFFF"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Start typing to search"
                                       Foreground="#55FFFFFF" FontSize="14"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading indicator -->
                        <ProgressRing x:Name="SearchSpinner" IsActive="False"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,12" Visibility="Collapsed" />

                        <!-- Results -->
                        <ListView x:Name="ResultsList"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  ItemClick="ResultsList_ItemClick"
                                  IsItemClickEnabled="True"
                                  Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SearchResult">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="32" Height="32"
                                                CornerRadius="6"
                                                Background="#22FFFFFF"
                                                Margin="0,0,12,0">
                                            <FontIcon Glyph="{x:Bind Icon}" FontSize="16"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Text -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Foreground="White" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       Foreground="#88FFFFFF" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>
